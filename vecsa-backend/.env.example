# Seeder ProductionDeveloperSeeder (producción: VECSA_SEED_DEVELOPER_PASSWORD obligatorio)
# VECSA_SEED_DEVELOPER_EMAIL=dev@vecsa.com
# VECSA_SEED_DEVELOPER_PASSWORD=
# VECSA_SEED_DEVELOPER_NICKNAME=developer
# VECSA_SEED_DEVELOPER_NAME=Developer
# VECSA_SEED_DEVELOPER_LAST_NAME=Vecsa

# Benchmark ADS — Meta Ad Library API (opcional si configuras el token desde el panel Benchmark ADS)
# META_ACCESS_TOKEN=

# Benchmark ADS — Web Scraper (Puppeteer): URL base del servicio Node `reportADS` del monorepo (sin barra final).
# Ejemplo tras desplegar reportADS en Railway: https://reportads-xxxx.up.railway.app
# El backend Laravel reenvía POST /api/scan (includeResults: true). Redespliega reportADS/ del monorepo si falta `results` en la respuesta.
# BENCHMARK_REPORT_ADS_URL=
# Microsegundos de pausa entre cada competidor en Meta API (por defecto 250000 = 0,25 s)
# BENCHMARK_META_REQUEST_DELAY_US=250000
# Segundos de timeout HTTP hacia reportADS (por defecto 900)
# BENCHMARK_REPORT_ADS_TIMEOUT=900