# Copiar a `.env.gantt` (ignorado por git).
#
# IMPORTANTE: GANTT_API_URL debe ser la base de la API (respuestas JSON),
# no la URL del panel Vite. El panel suele tener en el HTML meta name="api-base".
# Ejemplo panel: https://gantt-github-sync-production.up.railway.app/
# Ejemplo API:   https://awake-wonder-production.up.railway.app
#
# Opcional: GANTT_SYNC_TOKEN si la API lo requiere.

GANTT_API_URL=https://awake-wonder-production.up.railway.app
GANTT_GITHUB_USER=tu-usuario-github
